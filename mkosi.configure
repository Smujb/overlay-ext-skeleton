#!/usr/bin/env bash

# FIXME I hate stealing this from amethyris as it hard expects that the image this is being built from is using the exact same versioning scheme
# But I have yet to come up with a better way of doing it so,

# Grab our input data
DATA=$(jq "." /dev/stdin)

# Update the configuration data to reflect this
echo $(jq --arg update_date "$(cat base_image.snapshot)" '.Snapshot=$update_date' <<< $DATA) > /dev/stdout

